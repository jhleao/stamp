{
  "name": "stamp",
  "version": "1.0.0",
  "description": "Stamp is a small macOS utility for making document packs with people and agents. It keeps a project in one revisioned Google Drive file, works on ordinary local files, renders PDFs and XLSX files with established tools, and exposes one small workflow through its CLI and local Studio.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config studio/vite.config.ts",
    "build:studio": "vite build --config studio/vite.config.ts",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "test:studio": "vitest run --config studio/vite.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhleao/stamp.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jhleao/stamp/issues"
  },
  "homepage": "https://github.com/jhleao/stamp#readme",
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@preact/signals": "^2.11.0",
    "monaco-editor": "^0.52.2",
    "pdfjs-dist": "^6.2.108",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^26.2.0",
    "jsdom": "^29.1.1",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
